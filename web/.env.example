# Base URL của API. Dev: để "/api/v1" để đi qua Vite proxy (tránh CORS).
# Production: URL đầy đủ, ví dụ https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Nơi Vite proxy chuyển tiếp /api khi chạy `npm run dev`
VITE_API_PROXY_TARGET=http://localhost:8000

# Backend bắt buộc model_id (UUID) khi tạo conversation nhưng chưa có API danh sách model.
# Tạm dùng một UUID cố định cho tới khi có module models.
VITE_DEFAULT_MODEL_ID=00000000-0000-0000-0000-000000000001
