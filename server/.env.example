APP_NAME=AI-Workflow-Platform
APP_VERSION=1.0.0
DEBUG=true

# Database (khi chạy bằng docker compose, DB_HOST/DB_PORT được override thành db/5432)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=ai_workflow

# JWT
JWT_SECRET_KEY=change_me_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
SECRET_KEY=change_me_another_random_string

# AI providers — để trống key của provider không dùng
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ollama (endpoint tương thích OpenAI, phải có /v1):
#   local: http://localhost:11434/v1  (chạy server trong docker: http://host.docker.internal:11434/v1)
#   cloud: https://ollama.com/v1 + OLLAMA_API_KEY
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
AI_REQUEST_TIMEOUT=120
AI_MAX_RETRIES=2

CORS_ORIGINS=["*"]
