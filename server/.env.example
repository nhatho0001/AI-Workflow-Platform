APP_NAME=AI-Workflow-Platform
APP_VERSION=1.0.0
DEBUG=true

# Database (khi chạy bằng docker compose, DB_HOST/DB_PORT được override thành db/5432)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=ai_workflow

# JWT
JWT_SECRET_KEY=change_me_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
SECRET_KEY=change_me_another_random_string

CORS_ORIGINS=["*"]
